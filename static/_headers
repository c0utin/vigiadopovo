# Applied by Workers static assets (wrangler.jsonc); other hosts need equivalent rules.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/pipeline/v1/*
  Cache-Control: public, max-age=31536000, immutable

# The OpenTimestamps upgrade rewrites pending proofs; each deploy rewrites the checksum list.
/pipeline/timestamps/*
  Cache-Control: public, max-age=0, must-revalidate

/SHA256SUMS
  Cache-Control: public, max-age=0, must-revalidate

/legislativo.json
  Cache-Control: public, max-age=0, must-revalidate

/dados.json
  Cache-Control: public, max-age=0, must-revalidate
