{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vigiadopovo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // `pnpm build` output; _headers in it sets cache rules.
    "directory": "build",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Everything else is served as static files without invoking the Worker.
    "run_worker_first": ["/api/*", "/fotos/*"],
  },
  // Photos and precomputed metrics (scripts/metrics.ts). The Worker has no
  // secrets and never queries the lake.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "vigia-media" }],
  // Global 12-hour cache in front of R2 (worker/db.ts). The database ID is
  // not a secret: only this account can use it.
  "d1_databases": [
    {
      "binding": "CACHE",
      "database_name": "vigia-cache",
      "database_id": "3cda9309-22d8-47ce-ae78-83d972b50cab",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
}
