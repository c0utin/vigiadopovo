# Server-side configuration for the lake, budget and metrics scripts. The static site needs none of it.
# Never use PUBLIC_ prefixes for secrets.
# Copy to .env locally; real values belong in private environment/secret settings.
# Setup steps: docs/tecnico.md#configuração-uma-vez.

# lake/ (Rust): Basin Catalog access and R2 write on vigia-lake.
# budget.ts: CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN with Account Analytics read.
# metrics.ts: CLOUDFLARE_API_TOKEN with R2 write on vigia-media (sent with wrangler).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
LAKE_TOKEN=
# lake/: R2 S3 API key with read/write on vigia-lake.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
