# Optional server-side configuration. Never use PUBLIC_ prefixes for secrets.
# Copy to .env locally; real values belong in private environment/secret settings.
# prepare never invokes AI or S3, even when these variables are set.

# API compatible with chat/completions + strict JSON Schema structured outputs.
# No default provider or model. Example URL is illustrative, not a service.
AI_BASE_URL=https://inference.example.invalid/v1
AI_MODEL=
AI_API_KEY=

# S3 setup only: the CLI does not upload. No bucket is created automatically.
# For AWS, leave endpoint empty. For compatible storage, supply its HTTPS endpoint.
# HTTP is allowed only for a local MinIO endpoint.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=false
# Optional: omit these to use the SDK's standard workload identity/role chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Cloudflare (see README "Cloudflare: site, fotos e lake OLAP").
# lake/ (Rust) and scripts/metrics.ts: Basin Catalog + R2 write and Basin SQL read on vigia-lake.
# budget.ts: CLOUDFLARE_API_TOKEN with Account Analytics read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
LAKE_TOKEN=
# media.mjs: R2 S3 API key with read/write on vigia-media.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
