#!/usr/bin/env bash
# Prepares an Amp orb: pinned pnpm plus locked dependencies. Safe to rerun.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local name="$1"
  shift
  echo "==> $name"
  local start=$SECONDS
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

ensure_pnpm() {
  local wanted
  wanted="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
  if [[ "$(pnpm --version 2>/dev/null || true)" != "$wanted" ]]; then
    npm install --global --no-fund --no-audit "pnpm@$wanted"
  fi
  echo "node $(node --version), pnpm $(pnpm --version)"
}

step "Ensure pinned pnpm" ensure_pnpm
step "Install dependencies" pnpm install --frozen-lockfile
