#!/usr/bin/env bash
# Prepares an Amp orb: pinned pnpm plus locked dependencies. Safe to rerun.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

wanted="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
if [[ "$(pnpm --version 2>/dev/null || true)" != "$wanted" ]]; then
  npm install --global --no-fund --no-audit "pnpm@$wanted"
fi
echo "node $(node --version), pnpm $(pnpm --version)"
pnpm install --frozen-lockfile

# GitHub runs the daily collection and commits it there; `pnpm ship` deploys
# only what both remotes have.
git remote get-url github >/dev/null 2>&1 ||
  git remote add github https://github.com/c0utin/vigiadopovo.git
gh auth setup-git 2>/dev/null || true

# `pnpm ship` deploys from the orb with these project secrets.
for name in CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID; do
  [[ -n "${!name:-}" ]] || echo "warning: $name is not set; pnpm ship cannot deploy" >&2
done
